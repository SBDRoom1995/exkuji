{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.txt",
      "**/.*",
      "firestore.rules",
      "src/**",
      "build.py",
      "**/*.command",
      "*.zip",
      "*.cjs",
      "firebase-web-config.json",
      "skills-lock.json"
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}