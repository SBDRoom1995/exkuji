rules_version = '2';
// EXくじ 共有データのルール
// ・ログインしている人だけが読める
// ・自分の会員データ／申請は本人と管理者だけ
// ・ガチャの追加・削除、申請の承認は管理者だけ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function me() { return request.auth.token.email.lower(); }
    function adminPath() { return /databases/$(database)/documents/config/admins; }
    function isAdmin() { return signedIn() && exists(adminPath()) && me() in get(adminPath()).data.emails; }

    // 管理者の一覧（最初にログインした人が管理者になる）
    match /config/admins {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.emails == [me()];
      allow update: if isAdmin() && me() in request.resource.data.emails;
      allow delete: if false;
    }
    // 送料・案件などの設定（毎月1日の入れ替えは誰の端末でも行う）
    match /config/main {
      allow read, write: if signedIn();
    }
    // ガチャ（残り数は引いた人の端末が更新する）
    match /gachas/{id} {
      allow read, update: if signedIn();
      allow create, delete: if isAdmin();
    }
    // 会員データ
    match /users/{email} {
      allow read, write: if signedIn() && (me() == email || isAdmin());
    }
    // 案件の報告（スクショ）
    match /subs/{id} {
      allow get: if signedIn() && (resource == null || resource.data.email == me() || isAdmin());
      allow list: if signedIn() && (resource.data.email == me() || isAdmin());
      allow create: if signedIn() && request.resource.data.email == me();
      allow update, delete: if isAdmin();
    }
    // 景品の受け取り申請（住所が入るので本人と管理者だけ）
    match /requests/{id} {
      allow get: if signedIn() && (resource == null || resource.data.email == me() || isAdmin());
      allow list: if signedIn() && (resource.data.email == me() || isAdmin());
      allow create: if signedIn() && request.resource.data.email == me();
      allow update: if isAdmin() || (signedIn() && resource.data.email == me() && request.resource.data.email == me());
      allow delete: if isAdmin();
    }
    // 当選者速報
    match /winners/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }
    // 友だち招待の記録（招待コード・日時・名前の頭文字だけ）
    match /referrals/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['id','code','at','name','_v']);
    }
    // アンケートの回答
    match /answers/{id} {
      allow create: if signedIn() && request.resource.data.email == me();
      allow read: if isAdmin();
    }
  }
}
